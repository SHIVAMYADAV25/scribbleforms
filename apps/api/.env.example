# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Free tier: Neon (neon.tech), Supabase, Railway, or Render Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/scribbleforms

# Redis URL
# Free tier: Upstash (upstash.com) — serverless Redis, 10k commands/day free
# or Railway Redis addon, or local Redis for development
REDIS_URL=redis://localhost:6379

# 32+ character random string used to hash IP addresses (GDPR-friendly)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=change_this_to_a_random_32_char_string_minimum

# ── Email (optional but recommended) ─────────────────────────────────────────
# Resend — free tier: 3,000 emails/month, 100/day
# Sign up at resend.com → API Keys → Create Key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=ScribbleForms <noreply@yourdomain.com>

# ── Cloudinary (optional — for file upload feature) ───────────────────────────
# Free tier: 25 GB storage, 25 GB bandwidth/month
# Sign up at cloudinary.com → Dashboard → copy credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_api_secret_here

# ── Google OAuth (optional) ───────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth 2.0 Client
# Authorized redirect URI: https://your-api-domain.com/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8000

# Your deployed API URL (used for OAuth callback URIs)
BASE_URL=http://localhost:8000

# Your frontend URL (used for OAuth redirects and email links)
WEB_URL=http://localhost:3000

# CORS allowed origin — set to your frontend domain in production
CORS_ORIGIN=http://localhost:3000

# Log level
LOG_LEVEL=info
